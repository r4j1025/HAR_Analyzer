{
  "version": "1.0",
  "name": "SAML Filter",
  "description": "Filters for SAML 2.0 authentication flows: SSO, ACS, SLS, IdP/SP metadata, assertions, RelayState, ADFS, Shibboleth. Generic terms like 'assertion' and '/sso' are down-weighted to avoid false positives.",
  "match_mode": "any_field",
  "url_keywords": [
    { "keyword": "/saml",                                  "weight": 9  },
    { "keyword": "/saml2",                                 "weight": 9  },
    { "keyword": "/sso",                                   "weight": 3  },
    { "keyword": "/sso/saml",                              "weight": 9  },
    { "keyword": "/saml/sso",                              "weight": 9  },
    { "keyword": "/idp/sso",                               "weight": 8  },
    { "keyword": "/sp/sso",                                "weight": 8  },
    { "keyword": "/saml/acs",                              "weight": 10 },
    { "keyword": "/saml/sls",                              "weight": 9  },
    { "keyword": "/saml/metadata",                         "weight": 9  },
    { "keyword": "/saml/login",                            "weight": 9  },
    { "keyword": "/saml/logout",                           "weight": 9  },
    { "keyword": "/saml/consume",                          "weight": 10 },
    { "keyword": "/saml/callback",                         "weight": 9  },
    { "keyword": "/saml/response",                         "weight": 10 },
    { "keyword": "/saml/request",                          "weight": 9  },
    { "keyword": "/saml/assertion",                        "weight": 10 },
    { "keyword": "/saml/artifact",                         "weight": 8  },
    { "keyword": "/saml/post",                             "weight": 9  },
    { "keyword": "/saml/redirect",                         "weight": 9  },
    { "keyword": "/adfs/ls",                               "weight": 8  },
    { "keyword": "/adfs/saml",                             "weight": 9  },
    { "keyword": "/wsfed",                                 "weight": 7  },
    { "keyword": "/wstrust",                               "weight": 7  },
    { "keyword": "/auth/saml",                             "weight": 9  },
    { "keyword": "/login/saml",                            "weight": 9  },
    { "keyword": "/Shibboleth.sso",                        "weight": 10 },
    { "keyword": "/idp/profile",                           "weight": 6  },
    { "keyword": "/idp/profile/SAML2/Redirect/SSO",        "weight": 10 },
    { "keyword": "/idp/profile/SAML2/POST/SSO",            "weight": 10 },
    { "keyword": "/idp/profile/SAML2/POST/SLO",            "weight": 10 },
    { "keyword": "/idp/profile/SAML2/Redirect/SLO",        "weight": 10 },
    { "keyword": "SAMLRequest=",                           "weight": 10 },
    { "keyword": "SAMLResponse=",                          "weight": 10 },
    { "keyword": "RelayState=",                            "weight": 8  },
    { "keyword": "/EntityDescriptor",                      "weight": 9  },
    { "keyword": "/AssertionConsumerService",               "weight": 10 },
    { "keyword": "/SingleSignOnService",                   "weight": 10 },
    { "keyword": "/SingleLogoutService",                   "weight": 9  },
    { "keyword": "shibboleth",                             "weight": 9  },
    { "keyword": "shib-",                                  "weight": 8  }
  ],
  "req_header_keywords": [
    { "keyword": "SAMLRequest",        "weight": 10 },
    { "keyword": "SAMLResponse",       "weight": 10 },
    { "keyword": "RelayState",         "weight": 8  },
    { "keyword": "shib-",              "weight": 8  },
    { "keyword": "sm_user",            "weight": 4  },
    { "keyword": "sm_serversessionid", "weight": 4  }
  ],
  "res_header_keywords": [
    { "keyword": "SAMLResponse",  "weight": 10 },
    { "keyword": "SAMLRequest",   "weight": 10 },
    { "keyword": "RelayState",    "weight": 8  },
    { "keyword": "shib-handler",  "weight": 9  }
  ],
  "req_body_keywords": [
    { "keyword": "SAMLRequest",          "weight": 10 },
    { "keyword": "SAMLResponse",         "weight": 10 },
    { "keyword": "RelayState",           "weight": 8  },
    { "keyword": "assertion",            "weight": 2  },
    { "keyword": "saml_response",        "weight": 10 },
    { "keyword": "samlp:AuthnRequest",   "weight": 10 },
    { "keyword": "samlp:Response",       "weight": 10 },
    { "keyword": "samlp:LogoutRequest",  "weight": 9  },
    { "keyword": "samlp:LogoutResponse", "weight": 9  },
    { "keyword": "saml:Assertion",       "weight": 10 },
    { "keyword": "saml:Issuer",          "weight": 9  },
    { "keyword": "saml:NameID",          "weight": 9  },
    { "keyword": "AuthnContextClassRef", "weight": 8  },
    { "keyword": "AudienceRestriction",  "weight": 8  },
    { "keyword": "wresult",              "weight": 7  },
    { "keyword": "wctx",                 "weight": 5  },
    { "keyword": "wtrealm",              "weight": 7  }
  ],
  "res_body_keywords": [
    { "keyword": "SAMLResponse",                "weight": 10 },
    { "keyword": "SAMLRequest",                 "weight": 10 },
    { "keyword": "saml:Assertion",              "weight": 10 },
    { "keyword": "saml:Issuer",                 "weight": 9  },
    { "keyword": "saml:NameID",                 "weight": 9  },
    { "keyword": "saml:AttributeStatement",     "weight": 9  },
    { "keyword": "saml:AuthnStatement",         "weight": 9  },
    { "keyword": "samlp:Response",              "weight": 10 },
    { "keyword": "samlp:Status",                "weight": 8  },
    { "keyword": "samlp:StatusCode",            "weight": 8  },
    { "keyword": "IssueInstant",                "weight": 7  },
    { "keyword": "AuthnContextClassRef",        "weight": 8  },
    { "keyword": "urn:oasis:names:tc:SAML",     "weight": 10 },
    { "keyword": "AssertionConsumerServiceURL", "weight": 10 },
    { "keyword": "EntityDescriptor",            "weight": 9  },
    { "keyword": "wresult",                     "weight": 7  },
    { "keyword": "RelayState",                  "weight": 7  }
  ],
  "keyword_list": [],
  "combinations": [
    {
      "name": "SAML POST Binding — SP-initiated SSO",
      "description": "Browser POSTs a SAMLResponse to the SP ACS endpoint. The SP receives and validates the assertion. Most common SAML flow.",
      "url_keywords":        ["/saml/acs"],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   ["SAMLResponse", "RelayState"],
      "res_body_keywords":   []
    },
    {
      "name": "SAML Redirect Binding — IdP-initiated SSO",
      "description": "SAMLRequest is sent as a URL query parameter (GET redirect). IdP responds with a SAMLResponse containing the assertion.",
      "url_keywords":        ["SAMLRequest="],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   [],
      "res_body_keywords":   ["saml:Assertion", "samlp:StatusCode"]
    },
    {
      "name": "SAML Single Logout (SLO)",
      "description": "SP or IdP initiates logout via a samlp:LogoutRequest. A LogoutResponse confirms termination of the SSO session.",
      "url_keywords":        [],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   ["samlp:LogoutRequest"],
      "res_body_keywords":   ["samlp:StatusCode"]
    }
  ]
}
