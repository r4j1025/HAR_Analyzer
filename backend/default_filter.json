{
  "version": "1.0",
  "name": "Auth Filter (Default)",
  "description": "Filters for authentication and authorization flows: OAuth, OIDC, SAML, AWS Cognito, sessions, tokens, MFA, and SSO endpoints.",
  "match_mode": "any_field",
  "url_keywords": [
    "/oauth", "/oauth2", "/oidc",
    "/authorize", "/authorise",
    "/token", "/access_token", "/access-token",
    "/refresh_token", "/refresh-token", "/revoke",
    "/introspect", "/userinfo", "/jwks", "/jwks.json",
    "/.well-known/openid-configuration",
    "/.well-known/oauth-authorization-server",
    "/login", "/logout",
    "/sign_in", "/sign-in", "/signin",
    "/sign_out", "/sign-out", "/signout",
    "/session", "/sessions",
    "/auth", "/authenticate", "/authentication",
    "/callback", "/redirect", "/authorized",
    "/saml", "/saml2", "/sso",
    "/password", "/forgot_password", "/forgot-password",
    "/reset_password", "/reset-password",
    "/change_password", "/change-password",
    "/credentials", "/mfa", "/totp", "/otp",
    "/two_factor", "/two-factor",
    "/verify", "/verification",
    "/register", "/confirm", "/invite",
    "/api_key", "/api-key", "/apikey",
    "AWSCognitoIdentityProviderService",
    "/challenge", "/permissions", "/roles", "/grant",
    "cognito-idp.", "auth0.com", "okta.com",
    "onelogin.com", "pingone.com", "pingidentity.com", "keycloak",
    "accounts.google.com", "oauth2.googleapis.com",
    "openidconnect.googleapis.com",
    "identitytoolkit.googleapis.com", "securetoken.googleapis.com",
    "login.microsoftonline.com", "login.live.com", "login.windows.net",
    "appleid.apple.com", "api.twitter.com",
    "accounts.spotify.com", "id.twitch.tv",
    "zoom.us/oauth", "gitlab.com/oauth",
    "login.salesforce.com", "sso.amazonaws.com",
    "login.", "sso.", "idp.", ".auth.", "oauth.", "openid.",
    "saml.", "adfs.", "signin.", "identity.",
    "?code=", "?state=", "?nonce=", "?id_token=", "?access_token=",
    "?grant_type=", "?client_id=", "?redirect_uri=", "?scope=",
    "?code_challenge=", "?code_verifier=", "?response_type="
  ],
  "req_header_keywords": [
    "authorization",
    "x-access-token",
    "x-auth-token",
    "x-api-key",
    "x-session-token",
    "x-id-token",
    "x-refresh-token",
    "x-csrf-token",
    "x-xsrf-token",
    "x-amz-security-token",
    "x-amz-target",
    "www-authenticate",
    "proxy-authorization",
    "sm_user",
    "sm_userdn",
    "sm_serversessionid",
    "sm_serversessionid",
    "sm_sessiondrift",
    "smidentity",
    "smchallenge",
    "sm-auth-dir",
    "sm-authreason",
    "sm-agentname",
    "smtransactionid",
    "smretries",
    "smquerydata",
    "sm-universalid"
  ],
  "res_header_keywords": [
    "www-authenticate",
    "x-auth-token",
    "x-access-token",
    "x-id-token",
    "set-cookie: smsession",
    "set-cookie: smidentity",
    "smchallenge",
    "smauthreason",
    "sm-agentname"
  ],
  "req_body_keywords": [
    "grant_type", "client_id", "client_secret", "client_assertion",
    "SRP_A", "SRP_B", "SECRET_HASH", "AuthFlow", "AuthParameters",
    "ChallengeName", "ChallengeResponses", "assertion", "saml_response",
    "id_token_hint", "post_logout_redirect_uri",
    "code_verifier", "code_challenge",
    "cognitoAccessToken", "cognitoRefreshToken",
    "NEW_PASSWORD", "USERNAME", "PASSWORD","SMSESSION",
    "SMIDENTITY",
    "SMAUTHREASON",
    "TARGET",
    "SMAGENTNAME",
    "USER",
    "PASSWORD",
    "FCCID",
    "SMENC",
    "SMLOCALE",
    "SMQUERYDATA",
    "SMCHALLENGE"
  ],
  "res_body_keywords": [
    "access_token", "id_token", "refresh_token",
    "token_type", "expires_in",
    "AuthenticationResult", "cognitoAccessToken", "cognitoRefreshToken",
    "IdToken", "AccessToken", "RefreshToken","SMSESSION",
    "SMIDENTITY",
    "SMAUTHREASON",
    "smchallenge",
    "smerror",
    "policyserver",
    "webagent",
    "authentication successful",
    "authentication failed"
  ],
  "keyword_list": []
}
