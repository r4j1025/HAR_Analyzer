{
  "version": "1.0",
  "name": "OAuth 2.0 Filter",
  "description": "Filters for OAuth 2.0 flows only: authorization code, client credentials, device flow, PKCE, token refresh, revocation, introspection. Does NOT cover OIDC-specific signals (id_token, userinfo, discovery). Generic terms (code, scope, state, error) are down-weighted to avoid false positives on non-OAuth traffic.",
  "match_mode": "any_field",
  "url_keywords": [
    { "keyword": "/oauth",                              "weight": 9  },
    { "keyword": "/oauth2",                             "weight": 9  },
    { "keyword": "/authorize",                          "weight": 5  },
    { "keyword": "/authorise",                          "weight": 5  },
    { "keyword": "/token",                              "weight": 7  },
    { "keyword": "/access_token",                       "weight": 9  },
    { "keyword": "/access-token",                       "weight": 9  },
    { "keyword": "/refresh_token",                      "weight": 9  },
    { "keyword": "/refresh-token",                      "weight": 9  },
    { "keyword": "/revoke",                             "weight": 7  },
    { "keyword": "/introspect",                         "weight": 8  },
    { "keyword": "/.well-known/oauth-authorization-server", "weight": 10 },
    { "keyword": "/callback",                           "weight": 2  },
    { "keyword": "/authorized",                         "weight": 2  },
    { "keyword": "?code=",                              "weight": 4  },
    { "keyword": "?state=",                             "weight": 2  },
    { "keyword": "?access_token=",                      "weight": 9  },
    { "keyword": "?grant_type=",                        "weight": 10 },
    { "keyword": "?client_id=",                         "weight": 9  },
    { "keyword": "?redirect_uri=",                      "weight": 6  },
    { "keyword": "?scope=",                             "weight": 3  },
    { "keyword": "?code_challenge=",                    "weight": 9  },
    { "keyword": "?code_verifier=",                     "weight": 9  },
    { "keyword": "?response_type=",                     "weight": 7  },
    { "keyword": "?token_hint=",                        "weight": 7  },
    { "keyword": "zoom.us/oauth",                       "weight": 8  },
    { "keyword": "gitlab.com/oauth",                    "weight": 8  },
    { "keyword": "login.salesforce.com",                "weight": 7  },
    { "keyword": "oauth.",                              "weight": 7  }
  ],
  "req_header_keywords": [
    { "keyword": "Authorization",   "weight": 5  },
    { "keyword": "Bearer",          "weight": 8  },
    { "keyword": "x-access-token",  "weight": 7  },
    { "keyword": "x-refresh-token", "weight": 9  },
    { "keyword": "x-api-key",       "weight": 2  },
    { "keyword": "x-csrf-token",    "weight": 1  },
    { "keyword": "dpop",            "weight": 10 }
  ],
  "res_header_keywords": [
    { "keyword": "www-authenticate", "weight": 5  },
    { "keyword": "x-auth-token",     "weight": 6  },
    { "keyword": "x-access-token",   "weight": 8  },
    { "keyword": "dpop-nonce",        "weight": 10 }
  ],
  "req_body_keywords": [
    { "keyword": "grant_type",             "weight": 10 },
    { "keyword": "client_id",              "weight": 9  },
    { "keyword": "client_secret",          "weight": 9  },
    { "keyword": "client_assertion",       "weight": 9  },
    { "keyword": "client_assertion_type",  "weight": 9  },
    { "keyword": "code",                   "weight": 2  },
    { "keyword": "redirect_uri",           "weight": 7  },
    { "keyword": "scope",                  "weight": 3  },
    { "keyword": "state",                  "weight": 2  },
    { "keyword": "code_verifier",          "weight": 10 },
    { "keyword": "code_challenge",         "weight": 10 },
    { "keyword": "code_challenge_method",  "weight": 10 },
    { "keyword": "response_type",          "weight": 7  },
    { "keyword": "token_type_hint",        "weight": 9  },
    { "keyword": "username",               "weight": 2  },
    { "keyword": "password",               "weight": 2  },
    { "keyword": "refresh_token",          "weight": 9  },
    { "keyword": "post_logout_redirect_uri","weight": 7 }
  ],
  "res_body_keywords": [
    { "keyword": "access_token",           "weight": 10 },
    { "keyword": "refresh_token",          "weight": 9  },
    { "keyword": "token_type",             "weight": 8  },
    { "keyword": "expires_in",             "weight": 6  },
    { "keyword": "scope",                  "weight": 3  },
    { "keyword": "error",                  "weight": 1  },
    { "keyword": "error_description",      "weight": 4  },
    { "keyword": "token_endpoint",         "weight": 9  },
    { "keyword": "AuthenticationResult",   "weight": 7  },
    { "keyword": "AccessToken",            "weight": 9  },
    { "keyword": "RefreshToken",           "weight": 9  }
  ],
  "keyword_list": [],
  "combinations": [
    {
      "name": "Authorization Code Flow",
      "description": "Browser redirects to /authorize with response_type=code, then exchanges the code at /token for an access_token. The most common OAuth 2.0 flow for web apps.",
      "url_keywords":        ["/authorize"],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   ["grant_type", "redirect_uri"],
      "res_body_keywords":   ["access_token"]
    },
    {
      "name": "PKCE Extension (Authorization Code + Code Verifier)",
      "description": "Mobile/SPA apps use PKCE: code_challenge sent with /authorize, code_verifier sent with /token. Confirms PKCE-hardened auth code flow.",
      "url_keywords":        [],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   ["code_verifier", "grant_type"],
      "res_body_keywords":   ["access_token"]
    },
    {
      "name": "Token Refresh Flow",
      "description": "Client sends refresh_token with grant_type=refresh_token to obtain a new access_token without re-authentication.",
      "url_keywords":        [],
      "req_header_keywords": [],
      "res_header_keywords": [],
      "req_body_keywords":   ["refresh_token", "grant_type"],
      "res_body_keywords":   ["access_token"]
    }
  ]
}
